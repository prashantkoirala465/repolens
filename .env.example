# Copy to .env for local development. Never commit the real .env (gitignored).

LOG_LEVEL=INFO

# Postgres — two-tier creds. The app runs as a restricted role with no DDL rights;
# only `alembic upgrade` uses the owner role. Keep them separate even in dev so a
# bug in the app can never accidentally alter the schema.
DATABASE_URL=postgresql+asyncpg://repolens_app:repolens_app@localhost:5432/repolens
MIGRATION_DATABASE_URL=postgresql+asyncpg://repolens:repolens@localhost:5432/repolens

# Redis — arq job queue
REDIS_URL=redis://localhost:6379/0

# Qdrant — vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=repolens_chunks

# Which backend runs embeddings/generation. Default is "ollama" — free,
# self-hosted, no API key needed at all.
#
# Local (default): install Ollama (https://ollama.com), then:
#   ollama pull nomic-embed-text
#   ollama pull llama3.2
# No further config needed — the defaults below already point at them.
EMBEDDING_PROVIDER=ollama
GENERATION_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=llama3.2

# Cloud (opt-in, better retrieval/answer quality, costs money): set
# EMBEDDING_PROVIDER=voyage and/or GENERATION_PROVIDER=anthropic above, and
# fill in the matching key below. voyage-code-3 beats general text embedders
# on code retrieval specifically — the cloud path is worth it once you're
# past "does this work at all."
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: raises GitHub's unauthenticated rate limit for repo metadata lookups
GITHUB_TOKEN=

# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=["http://localhost:3000"]

# Indexing bounds — an arbitrary public repo is untrusted input
MAX_REPO_SIZE_MB=250
MAX_FILE_SIZE_KB=512
CLONE_TIMEOUT_S=120
MAX_FILES_INDEXED=5000

EMBEDDING_BATCH_SIZE=64
RETRIEVAL_TOP_K=8

# "dense" or "hybrid" (BM25 + dense, fused via Qdrant's Query API). Default
# is "hybrid" — it measurably wins on MRR/nDCG against the dense-only
# baseline, see the README's "Measuring retrieval quality" section for the
# real numbers. Both vector types are always indexed regardless of this
# setting, so switching it never requires re-indexing.
RETRIEVAL_MODE=hybrid

# Redis-backed rate limits (slowapi) on the two routes with real compute/cost
# behind them: indexing a repo, and generating an answer.
RATE_LIMIT_REPOS=5/minute
RATE_LIMIT_QUERY=20/minute
